#!/bin/bash
#SBATCH --job-name=topols_diag_qaoa_bf
#SBATCH --account=lab
#SBATCH --partition=gpu
#SBATCH --qos=urgent
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=00:30:00
#SBATCH --output=/home/junyuzh/QEC/upgrade/TopoLS/slurm/logs/%x_%j.out
#SBATCH --error=/home/junyuzh/QEC/upgrade/TopoLS/slurm/logs/%x_%j.err

# Does qaoa_16 actually reach basic_embedding (the brute-force tier)? Its
# orientation assignment inherits qubit_ori and never consults
# hadamard_edges for the edge into the node it places, so if it runs, that
# is a concrete place the 3 missing flips could be dropped.
REPO_ROOT=/home/junyuzh/QEC/upgrade/TopoLS
TRACE=/home/junyuzh/QEC/upgrade/TopoLS/slurm/logs/htrace_qaoa_bf_$SLURM_JOB_ID.tsv
: > "$TRACE"; export TOPOLS_H_DEBUG="$TRACE"
cd "$REPO_ROOT/docs"
uv run --project "$REPO_ROOT" prog.py -f qaoa_16 -b 20 -zx 1 -dir 1 -l 4 -r 0 -s 2 -t 2 -i 1000 -sp 0 -b0 0 -csv diag_qaoa_bf
echo "=== basic_embedding invocations ==="
grep -c "^basic_embedding" "$TRACE" || echo 0
